// ============================================================================
// {{ m.name }}_test_pkg -- tests generated by socgen from {{ spec_rel }}
//   {{ m.name }}_smoke_test         every master: write + read on every NoC port,
//                                   ID read of the first APB slot, DECERR hole
//   {{ m.name }}_ral_test           RAL reset values, then write/read of every
//                                   testable RW register through {{ m.ral_master }}
//   {{ m.name }}_path_latency_test  one master at a time, single beats on every
//                                   path; latency must be within ideal + slack
//   {{ m.name }}_traffic_test       every master runs its traffic profile at once
//   {{ m.name }}_scenario_test      +SCENARIO=<name>: the scenario's masters only
//   {{ m.name }}_cov_test           coverage closure: RAL bit-bash, every burst type,
//                                   size and length class on every VIP master and
//                                   every port, error responses, READY after VALID
// Plusargs: +SOC_ITEMS=<n> bursts per master (default 50), +SOC_TIMING=0|1|2,
// +SOC_LAT_STRICT (a missed latency_target is an error), +VCD.
// ============================================================================
`ifndef {{ M }}_TEST_PKG_SV
`define {{ M }}_TEST_PKG_SV
package {{ m.name }}_test_pkg;
  import uvm_pkg::*;
  `include "uvm_macros.svh"
  import axi4_pkg::*;
  import {{ m.name }}_pkg::*;
  import {{ m.name }}_ral_pkg::*;
  import {{ m.name }}_env_pkg::*;

  // one master's traffic over its windows
  class {{ m.name }}_traffic_seq extends uvm_sequence #(axi4_item);
    `uvm_object_utils({{ m.name }}_traffic_seq)
    int mi, scn = -1, items = 50;
    window_t w [$];
    int unsigned cursor [$];        // linear / block2d progress per window
    bit pace_all;                   // +SOC_PACE: pace every profile that has bandwidth_mbps

    function new(string name = "{{ m.name }}_traffic_seq");
      super.new(name);
    endfunction

    function axi4_item next(int k);
      window_t x = w[k];
      axi4_item t = axi4_item::type_id::create("t");
      int unsigned beats, room;
      logic [31:0] a;
      t.write = ($urandom_range(99, 0) >= x.read_pct);
      t.id = $urandom_range((1 << ID_WIDTH) - 1, 0);
      t.size = 3'd2; t.burst = AXI4_INCR;
      beats = $urandom_range(x.beats_hi, x.beats_lo);
      if (x.apb) begin                    // ID read of a random mapped slot
        int s = $urandom_range(APB_NMAPPED - 1, 0);
        t.write = 0; t.addr = APB_BASE + (APB_MAPPED_SLOT[s] << 12); t.len = 0;
        t.alloc(); t.strb[0] = 4'hF;
        return t;
      end
      case (x.pattern)
        PAT_LINEAR: begin
          a = x.base + cursor[k];
          room = (4096 - (a & 32'hFFF)) / 4;
          if (beats > room) beats = room;
          cursor[k] = (cursor[k] + beats * 4) % x.size;
        end
        PAT_BLOCK2D: begin               // cursor = line * blk_w + column
          int unsigned line = cursor[k] / x.blk_w, col = cursor[k] % x.blk_w;
          a = x.base + line * x.stride + col;
          room = (x.blk_w - col) / 4;
          if ((4096 - (a & 32'hFFF)) / 4 < room) room = (4096 - (a & 32'hFFF)) / 4;
          if (beats > room) beats = room;
          cursor[k] = (cursor[k] + beats * 4) % (x.blk_w * x.blk_h);
        end
        default: begin
          a = x.base + ($urandom_range(x.size / 4 - 1, 0) * 4);
          room = (4096 - (a & 32'hFFF)) / 4;
          if (beats > room) beats = room;
          if (a + beats * 4 > x.base + x.size) beats = (x.base + x.size - a) / 4;
        end
      endcase
      if (beats == 0) beats = 1;
      t.addr = a; t.len = beats - 1;
      t.alloc();
      foreach (t.data[i]) begin t.data[i] = $urandom; t.strb[i] = 4'hF; end
      return t;
    endfunction

    task body();
      get_windows(scn, mi, w);
      if (w.size() == 0) return;
      foreach (w[i]) cursor.push_back(0);
      pace_all = $test$plusargs("SOC_PACE");
      repeat (items) begin
        int k = $urandom_range(w.size() - 1, 0);
        axi4_item t = next(k);
        realtime t0 = $realtime;
        start_item(t);
        finish_item(t);
        if ((w[k].pace || pace_all) && w[k].bw_mbps && !w[k].apb) begin
          // start-to-start spacing for this burst at the requested rate:
          // bytes / (MB/s) = bytes * 1000 / bw ns
          realtime due = t0 + (real'((t.len + 1) * 4) * 1000.0 / real'(w[k].bw_mbps)) * 1ns;
          if ($realtime < due) #(due - $realtime);
        end
        else if (w[k].gap) #(w[k].gap * TCK * 1ns);
      end
    endtask
  endclass

  // ==========================================================================
  class {{ m.name }}_base_test extends uvm_test;
    `uvm_component_utils({{ m.name }}_base_test)
    {{ m.name }}_env     env;
    {{ m.name }}_env_cfg cfg;
    int items = 50;

    function new(string name, uvm_component parent);
      super.new(name, parent);
    endfunction

    function void build_phase(uvm_phase phase);
      int timing = 1;
      super.build_phase(phase);
      void'($value$plusargs("SOC_ITEMS=%d", items));
      void'($value$plusargs("SOC_TIMING=%d", timing));
      cfg = {{ m.name }}_env_cfg::type_id::create("cfg");
      cfg.set_timing(timing);
      cfg.lat_strict = $test$plusargs("SOC_LAT_STRICT");
      configure(cfg);
      uvm_config_db#({{ m.name }}_env_cfg)::set(this, "env", "cfg", cfg);
      env = {{ m.name }}_env::type_id::create("env", this);
    endfunction

    virtual function void configure({{ m.name }}_env_cfg c);
    endfunction

    function void end_of_elaboration_phase(uvm_phase phase);
      uvm_root::get().set_timeout(100ms, 1);
    endfunction

    task run_phase(uvm_phase phase);
      phase.raise_objection(this);
      #(20 * TCK * 1ns);
      body();
      #(50 * TCK * 1ns);
      phase.drop_objection(this);
    endtask

    virtual task body();
    endtask

    // single-beat accesses; the scoreboard checks the responses and data
    task wr(int mi, logic [31:0] a, bit [31:0] d);
      axi4_resp_e r;
      axi4_api::write32(env.m_agent[mi].sqr, a, d, r);
    endtask
    task rd(int mi, logic [31:0] a);
      axi4_resp_e r;
      bit [31:0] d;
      axi4_api::read32(env.m_agent[mi].sqr, a, d, r);
    endtask
    task wr_rd(int mi, logic [31:0] a);
      wr(mi, a, $urandom);
      rd(mi, a);
    endtask

    function bit vip_master(int mi);
      return env.m_agent[mi].sqr != null;
    endfunction
  endclass

  // ==========================================================================
  class {{ m.name }}_smoke_test extends {{ m.name }}_base_test;
    `uvm_component_utils({{ m.name }}_smoke_test)
    function new(string name, uvm_component parent);
      super.new(name, parent);
    endfunction
    task body();
      for (int i = 0; i < NM; i++) if (vip_master(i)) spawn(i);
      wait fork;
    endtask
    task automatic spawn(int i);
      fork
        automatic int mi = i;
        begin
          for (int si = 0; si < NS; si++) begin
            if (S_KIND[si] == "apb_bridge") rd(mi, PATH_ADDR[mi][si]);
            else wr_rd(mi, PATH_ADDR[mi][si]);
          end
          if (HAS_UNMAPPED) rd(mi, UNMAPPED_ADDR);
        end
      join_none
    endtask
  endclass

  // ==========================================================================
  class {{ m.name }}_ral_test extends {{ m.name }}_base_test;
    `uvm_component_utils({{ m.name }}_ral_test)
    function new(string name, uvm_component parent);
      super.new(name, parent);
    endfunction
    task body();
      uvm_reg_hw_reset_seq rst = uvm_reg_hw_reset_seq::type_id::create("rst");
      uvm_reg regs[$];
      uvm_status_e st;
      int n = 0;
      rst.model = env.regmodel;
      rst.start(null);
      env.regmodel.get_registers(regs);
      foreach (regs[i]) begin
        uvm_reg_field f[$];
        bit rw = 1;
        if (uvm_resource_db#(bit)::get_by_name({"REG::", regs[i].get_full_name()}, "NO_REG_TESTS", 0) != null) continue;
        regs[i].get_fields(f);
        foreach (f[j]) if (f[j].get_access() != "RW") rw = 0;
        if (!rw) continue;
        repeat (2) begin
          uvm_reg_data_t v = {$urandom, $urandom};
          regs[i].write(st, v);
          if (st != UVM_IS_OK) `uvm_error("RAL", {regs[i].get_full_name(), ": write failed"})
          regs[i].mirror(st, UVM_CHECK);
          n++;
        end
      end
      `uvm_info("RAL", $sformatf("reset values checked on %0d registers, %0d write/read checks",
                regs.size(), n), UVM_LOW)
      $display("RAL_PASS regs=%0d rw_checks=%0d", regs.size(), n);
    endtask
  endclass

  // ==========================================================================
  class {{ m.name }}_path_latency_test extends {{ m.name }}_base_test;
    `uvm_component_utils({{ m.name }}_path_latency_test)
    function new(string name, uvm_component parent);
      super.new(name, parent);
    endfunction
    function void configure({{ m.name }}_env_cfg c);
      c.set_timing(0);
      c.zero_load_check = 1;
    endfunction
    task body();
      for (int mi = 0; mi < NM; mi++) begin
        if (!vip_master(mi)) continue;
        for (int si = 0; si < NS; si++) begin
          if (S_KIND[si] == "apb_bridge") begin
            rd(mi, PATH_ADDR[mi][si]);
            wr(mi, PATH_ADDR[mi][si] + 32'h10, $urandom);
          end else wr_rd(mi, PATH_ADDR[mi][si]);
        end
      end
    endtask
  endclass

  // ==========================================================================
  class {{ m.name }}_traffic_test extends {{ m.name }}_base_test;
    `uvm_component_utils({{ m.name }}_traffic_test)
    int scn = -1;
    function new(string name, uvm_component parent);
      super.new(name, parent);
    endfunction
    task body();
      for (int i = 0; i < NM; i++) if (vip_master(i)) spawn(i);
      wait fork;
    endtask
    task automatic spawn(int mi);
      {{ m.name }}_traffic_seq s = {{ m.name }}_traffic_seq::type_id::create($sformatf("traffic_%s", M_NAME[mi]));
      s.mi = mi; s.scn = scn; s.items = items;
      fork
        automatic {{ m.name }}_traffic_seq sq = s;
        automatic int k = mi;
        sq.start(env.m_agent[k].sqr);
      join_none
    endtask
  endclass

  class {{ m.name }}_scenario_test extends {{ m.name }}_traffic_test;
    `uvm_component_utils({{ m.name }}_scenario_test)
    function new(string name, uvm_component parent);
      super.new(name, parent);
    endfunction
    task body();
      string name;
      if (!$value$plusargs("SCENARIO=%s", name)) `uvm_fatal("SCN", "+SCENARIO=<name> required")
      foreach (SCN_NAME[i]) if (N_SCN > 0 && SCN_NAME[i] == name) scn = i;
      if (scn < 0) `uvm_fatal("SCN", {"unknown scenario ", name})
      `uvm_info("SCN", {"scenario ", name}, UVM_LOW)
      super.body();
    endtask
  endclass
  // ==========================================================================
  // {{ m.name }}_cov_test -- directed coverage closure of the generated RTL, the
  // protocol checkers' cover properties and the agents' covergroups:
  //  * RAL bit-bash of every testable register, every bit of WO registers both
  //    ways, unmapped offsets of every mapped APB slot (PSLVERR)
  //  * every VIP master and every NoC port at least once: FIXED / WRAP / narrow /
  //    unaligned / partially strobed / long bursts (the APB port gets them on an
  //    empty slot, which answers SLVERR), DECERR outside the map
  //  * external APB completers: strobed writes, reads, their PSLVERR window
  //  * READY only after VALID on both sides of the NoC, heavy back-pressure
  class {{ m.name }}_cov_test extends {{ m.name }}_base_test;
    `uvm_component_utils({{ m.name }}_cov_test)
    function new(string name, uvm_component parent);
      super.new(name, parent);
    endfunction

    function void configure({{ m.name }}_env_cfg c);
      c.set_timing(2);
      foreach (c.m_cfg[i]) c.m_cfg[i].ready_after_valid = 1;
      foreach (c.s_cfg[i]) c.s_cfg[i].ready_after_valid = 1;
      for (int i = 0; i < NAPB_VIP; i++) begin
        logic [31:0] b = apb_vip_base(i);
        c.apb_cfg_h[i].err_lo = b + 32'hF00;
        c.apb_cfg_h[i].err_hi = b + 32'hFFF;
      end
    endfunction

    function logic [31:0] apb_vip_base(int i);
      foreach (APB_SLOT_NAME[k])
        if (APB_SLOT_NAME[k] == APB_VIP_NAME[i]) return APB_BASE + (APB_MAPPED_SLOT[k] << 12);
      return APB_BASE;
    endfunction

    // first (or last) empty APB slot (answers SLVERR), 0 when every slot is mapped
    function logic [31:0] empty_slot(bit last = 0);
      logic [31:0] r = 0;
      for (int sl = 0; sl < APB_NSLOTS; sl++) begin
        bit used = 0;
        foreach (APB_MAPPED_SLOT[k]) if (APB_MAPPED_SLOT[k] == sl) used = 1;
        if (!used && (last || r == 0)) r = APB_BASE + (sl << 12);
      end
      return r;
    endfunction

    task run_item(int mi, bit wr, logic [31:0] a, int beats, bit [2:0] size, axi4_burst_e burst,
                  bit partial = 0);
      axi4_item t = axi4_api::make(wr, a, beats, size, burst, 8'($urandom_range((1 << ID_WIDTH) - 1, 0)));
      t.prot = 3'($urandom);
      if (partial) foreach (t.strb[i]) t.strb[i] = t.lanes(i) & 4'($urandom_range(14, 1));
      axi4_api::run(env.m_agent[mi].sqr, t);
    endtask

    // every burst shape, written then read back
    task shapes(int mi, logic [31:0] a, bit long_ok);
      for (int wr = 1; wr >= 0; wr--) begin
        run_item(mi, wr, a,          4,  2, AXI4_FIXED);
        run_item(mi, wr, a,          1,  2, AXI4_FIXED);
        run_item(mi, wr, a,          16, 2, AXI4_FIXED);
        run_item(mi, wr, a + 32'h8,  4,  2, AXI4_WRAP);
        run_item(mi, wr, a + 32'h20, 16, 2, AXI4_WRAP);
        run_item(mi, wr, a + 32'h41, 6,  0, AXI4_INCR, wr);    // byte beats, unaligned start
        run_item(mi, wr, a + 32'h82, 5,  1, AXI4_INCR, wr);    // halfword beats
        run_item(mi, wr, a + 32'hC2, 3,  2, AXI4_INCR, wr);    // unaligned word start, partial strobes
        if (long_ok) run_item(mi, wr, a + 32'h100, 64, 2, AXI4_INCR);
      end
    endtask

    task body();
      logic [31:0] hole = empty_slot();
{% if m.noc.model == 'behavioral' %}      env.noc.ready_after_valid = 1;
{% endif %}      ral_bash();
      // every VIP master and every NoC port gets the burst shapes at least once:
      // pair k = 0 .. max(masters, ports) - 1 -> (k-th VIP master, port k)
      begin
        int vm[$];
        for (int mi = 0; mi < NM; mi++) if (vip_master(mi)) vm.push_back(mi);
        for (int k = 0; k < (vm.size() > NS ? vm.size() : NS); k++) begin
          int mi = vm[k % vm.size()], si = k % NS;
          if (S_KIND[si] == "apb_bridge") begin
            if (hole != 0) shapes(mi, hole, 0);
          end else if (S_KIND[si] != "periph") shapes(mi, PATH_ADDR[mi][si] & ~32'hFFF, 1);   // stays in its 4 KB granule
          else begin                                      // RTL slave
            shapes(mi, PATH_ADDR[mi][si] & ~32'hFFF, 0);
            if (k < NS) rtl_slave_walk(mi, si);
          end
        end
        if (HAS_UNMAPPED) foreach (vm[i]) begin
          run_item(vm[i], 1, UNMAPPED_ADDR, 2, 2, AXI4_INCR);
          run_item(vm[i], 0, UNMAPPED_ADDR, 2, 2, AXI4_INCR);
        end
      end
      if (hole != 0) apb_port_stress(hole, empty_slot(1));
      for (int i = 0; i < NAPB_VIP; i++) begin
        logic [31:0] b = apb_vip_base(i);
        int mi = first_vip();
        axi4_item t;
        for (int p = 0; p < 2; p++) begin               // every read-data bit both ways
          axi4_resp_e r;
          bit [31:0] d;
          axi4_api::write32(env.m_agent[mi].sqr, b + 32'h80, p ? 32'h0 : 32'hFFFF_FFFF, r);
          axi4_api::read32(env.m_agent[mi].sqr, b + 32'h80, d, r);
        end
        t = axi4_api::make(1, b + 32'h84, 1, 2, AXI4_INCR, 0);    // write with no byte strobe
        t.strb[0] = 4'h0;
        axi4_api::run(env.m_agent[mi].sqr, t);
        for (int k = 0; k < 4; k++) begin
          run_item(mi, 1, b + 32'h40 + 4 * k, 1, 2, AXI4_INCR, k[0]);
          run_item(mi, 0, b + 32'h40 + 4 * k, 1, 2, AXI4_INCR);
        end
        run_item(mi, 1, b + 32'hF00, 1, 2, AXI4_INCR);          // PSLVERR window
        run_item(mi, 0, b + 32'hF00, 1, 2, AXI4_INCR);
      end
      $display("COV_PASS");
    endtask

    // RTL slave port: every address bit of its window both ways, 256-beat bursts
    task rtl_slave_walk(int mi, int si);
      logic [31:0] base = S_BASE[si], size = 32'h1000;
      size = rtl_slave_size(si);
      for (int b = 2; (32'd1 << b) < size; b++) begin
        run_item(mi, 0, base + (32'd1 << b), 1, 2, AXI4_INCR);
        run_item(mi, 1, base + (32'd1 << b), 1, 2, AXI4_INCR);
      end
      run_item(mi, 0, base + size - 32'h400, 256, 2, AXI4_INCR);
      run_item(mi, 1, base + size - 32'h400, 256, 2, AXI4_INCR);
      run_item(mi, 0, base, 1, 2, AXI4_INCR);
    endtask

    function logic [31:0] rtl_slave_size(int si);
{% for t in m.slaves %}      if (si == S_{{ t.name|upper }}) return 32'h{{ '%08X'|format(t.size) }};
{% endfor %}      return 32'h1000;
    endfunction

    function int first_vip();
      for (int mi = 0; mi < NM; mi++) if (vip_master(mi)) return mi;
      return 0;
    endfunction

    // APB port: 256-beat bursts, and a read racing a write so the bridge is
    // busy when the next request arrives (READY low while VALID)
    task apb_port_stress(logic [31:0] hole, logic [31:0] hole_hi);
      int ma = first_vip(), mb = -1;
      for (int mi = ma + 1; mi < NM; mi++) if (mb < 0 && vip_master(mi)) mb = mi;
      run_item(ma, 1, hole, 256, 2, AXI4_INCR);
      run_item(ma, 0, hole, 256, 2, AXI4_INCR);
      run_item(ma, 0, hole, 1, 2, AXI4_INCR);
      run_item(ma, 1, hole_hi + 32'hFFC, 1, 2, AXI4_INCR);     // top slot and offset bits
      run_item(ma, 0, hole_hi + 32'hFFC, 1, 2, AXI4_INCR);
      if (mb < 0) return;
      for (int k = 0; k < 32; k++) fork             // the second request arrives while the first runs
        begin #((k % 16) * 3 * TCK * 1ns); run_item(ma, k < 16, hole, 4, 2, AXI4_INCR); end
        run_item(mb, k >= 16, hole + 32'h40, 4, 2, AXI4_INCR);
      join
    endtask

    // RAL: bit-bash every testable register, WO registers all-ones then zero,
    // an unmapped offset of every mapped slot (PSLVERR)
    task ral_bash();
      uvm_reg_bit_bash_seq bb = uvm_reg_bit_bash_seq::type_id::create("bb");
      uvm_reg regs[$];
      uvm_status_e st;
      bb.model = env.regmodel;
      bb.start(null);
      env.regmodel.get_registers(regs);
      foreach (regs[i]) begin
        uvm_reg_field f[$];
        bit wo = 1;
        regs[i].get_fields(f);
        foreach (f[j]) if (f[j].get_access() != "WO") wo = 0;
        if (!wo) continue;
        regs[i].write(st, '1);
        regs[i].write(st, '0);
      end
      foreach (regs[i]) begin                           // every register read once
        uvm_reg_data_t v;
        regs[i].read(st, v);
      end
      foreach (APB_MAPPED_SLOT[k]) begin
        int mi = first_vip();
        run_item(mi, 0, APB_BASE + (APB_MAPPED_SLOT[k] << 12) + 32'hFFC, 1, 2, AXI4_INCR);
        run_item(mi, 1, APB_BASE + (APB_MAPPED_SLOT[k] << 12) + 32'hFFC, 1, 2, AXI4_INCR);
      end
    endtask
  endclass
endpackage
`endif
