// ============================================================================
// {{ m.name }}_pkg -- SoC configuration generated by socgen from {{ spec_rel }}
// {{ m.desc }}
// Do not edit: change the spec and run socgen again.
// ============================================================================
`ifndef {{ M }}_PKG_SV
`define {{ M }}_PKG_SV
package {{ m.name }}_pkg;
  // ---------------- sizes ----------------
  localparam int NM  = {{ m.masters|length }};       // AXI masters
  localparam int NS  = {{ m.targets|length }};       // NoC slave ports
  localparam int NCH = {{ m.nch }};       // interleaved memory channels (ports 0..NCH-1)
  localparam int S_DEF = NS;       // decode miss: DECERR from the NoC default slave
  localparam int MESH_ROWS = {{ m.noc.rows }}, MESH_COLS = {{ m.noc.cols }};
  localparam int NI_CYCLES = {{ m.noc.ni }}, ROUTER_CYCLES = {{ m.noc.router }}, LINK_CYCLES = {{ m.noc.link }};
  localparam real CLK_PERIOD_NS = {{ m.clock.period_ns }};
  localparam int ID_WIDTH = {{ m.id_width }};

  // ---------------- masters ----------------
{% for x in m.masters %}  localparam int M_{{ x.name|upper }} = {{ x.index }};
{% endfor %}
  // ---------------- NoC slave ports ----------------
{% for t in m.targets %}  localparam int S_{{ t.name|upper }} = {{ t.index }};{% if t.kind != 'channel' %}   // {{ t.kind }}{% endif %}
{% endfor %}{% if m.apb %}  localparam int S_APB = {{ m.apb.index }};
{% endif %}{% for mem in m.memories %}  localparam int S_{{ mem.name|upper }}_FIRST = {{ mem.first }}, {{ mem.name|upper }}_NCH = {{ mem.channels }};
{% endfor %}
  localparam string M_NAME [NM] = '{ {{ m.masters|map(attribute='name')|map('sv_str')|join(', ') }} };
  localparam string S_NAME [NS+1] = '{ {{ m.targets|map(attribute='name')|map('sv_str')|join(', ') }}, "decerr" };
  localparam string S_KIND [NS+1] = '{ {{ m.targets|map(attribute='kind')|map('sv_str')|join(', ') }}, "default" };

  // ---------------- address map ----------------
{% for mem in m.memories %}  localparam logic [31:0] {{ mem.name|upper }}_BASE = 32'h{{ '%08X'|format(mem.base) }}, {{ mem.name|upper }}_SIZE = 32'h{{ '%08X'|format(mem.size - 1) }} + 1;
  localparam int {{ mem.name|upper }}_GRANULE_BITS = {{ mem.gbits }}, {{ mem.name|upper }}_CH_BITS = {{ mem.cbits }}, {{ mem.name|upper }}_HASH = {{ 1 if mem.hash == 'xor' else 0 }};
  localparam int {{ mem.name|upper }}_ACCESS = {{ mem.access }};   // {{ mem.kind }}{% if mem.timing %}, timing preset {{ mem.timing }}{% endif %}

{% endfor %}{% for s in m.slaves %}  localparam logic [31:0] {{ s.name|upper }}_BASE = 32'h{{ '%08X'|format(s.base) }}, {{ s.name|upper }}_SIZE = 32'h{{ '%08X'|format(s.size) }};
{% endfor %}
  localparam logic [31:0] S_BASE [NS] = '{ {{ m.targets|map(attribute='base')|map('sv_h32')|join(', ') }} };
  localparam int S_ACCESS [NS] = '{ {{ m.targets|map(attribute='access')|join(', ') }} };
{% for mem in m.memories %}
  // {{ mem.name }}: channel = off[{{ mem.gbits + mem.cbits - 1 }}:{{ mem.gbits }}]{% if mem.hash == 'xor' %} ^ off[{{ mem.gbits + 2*mem.cbits - 1 }}:{{ mem.gbits + mem.cbits }}]{% endif %}, off = a - {{ mem.name|upper }}_BASE
  function automatic int {{ m.prefix }}_{{ mem.name }}_channel(logic [31:0] a);
    logic [31:0] off = a - {{ mem.name|upper }}_BASE;
    logic [{{ mem.cbits - 1 }}:0] c = off[{{ mem.gbits + mem.cbits - 1 }}:{{ mem.gbits }}]{% if mem.hash == 'xor' %} ^ off[{{ mem.gbits + 2*mem.cbits - 1 }}:{{ mem.gbits + mem.cbits }}]{% endif %};
    return int'(c);
  endfunction
  // channel-local address: the offset with the channel-select bits removed
  function automatic logic [31:0] {{ m.prefix }}_{{ mem.name }}_local(logic [31:0] a);
    logic [31:0] off = a - {{ mem.name|upper }}_BASE;
    return ((off >> {{ mem.gbits + mem.cbits }}) << {{ mem.gbits }}) | (off & 32'h{{ '%08X'|format(mem.granule - 1) }});
  endfunction
{% endfor %}{% if m.memories|length == 1 %}{% set mem = m.memories[0] %}  function automatic int dram_channel(logic [31:0] a); return {{ m.prefix }}_{{ mem.name }}_channel(a); endfunction
  function automatic logic [31:0] dram_local(logic [31:0] a); return {{ m.prefix }}_{{ mem.name }}_local(a); endfunction
  function automatic int {{ m.prefix }}_dram_channel(logic [31:0] a); return {{ m.prefix }}_{{ mem.name }}_channel(a); endfunction
  function automatic logic [31:0] {{ m.prefix }}_dram_local(logic [31:0] a); return {{ m.prefix }}_{{ mem.name }}_local(a); endfunction
{% endif %}
  // address -> NoC slave port (S_DEF on a miss)
  function automatic int {{ m.prefix }}_decode(logic [31:0] a);
{% for mem in m.memories %}    if (a >= {{ mem.name|upper }}_BASE && a - {{ mem.name|upper }}_BASE < 33'({{ mem.name|upper }}_SIZE))
      return S_{{ mem.name|upper }}_FIRST + {{ m.prefix }}_{{ mem.name }}_channel(a);
{% endfor %}{% for s in m.slaves %}    if (a >= {{ s.name|upper }}_BASE && a - {{ s.name|upper }}_BASE < {{ s.name|upper }}_SIZE) return S_{{ s.name|upper }};
{% endfor %}    return S_DEF;
  endfunction

{% if m.apb %}  // ---------------- APB slots ({{ m.apb.name }}) ----------------
  localparam logic [31:0] APB_BASE = 32'h{{ '%08X'|format(m.apb.base) }};
  localparam int APB_SLOT_BITS = {{ apb_slot_bits }};          // PADDR[{{ 11 + apb_slot_bits }}:12]
  localparam int APB_NSLOTS = {{ apb_nslots }};            // slots in the window
{% for s in m.apb.slots %}  localparam int APB_SLOT_{{ s.name|upper }} = {{ s.slot }};   // 0x{{ '%08X'|format(s.base) }} {{ s.kind }} {{ s.ip or s.regs or 'apb vip' }}
{% endfor %}  localparam int APB_NMAPPED = {{ m.apb.slots|length }};
  localparam int APB_MAPPED_SLOT [APB_NMAPPED] = '{ {{ m.apb.slots|map(attribute='slot')|join(', ') }} };
  localparam string APB_SLOT_NAME [APB_NMAPPED] = '{ {{ m.apb.slots|map(attribute='name')|map('sv_str')|join(', ') }} };
  // ID register value per mapped slot (0: no ID register)
  localparam logic [31:0] APB_SLOT_ID [APB_NMAPPED] = '{ {{ slot_ids|map('sv_h32')|join(', ') }} };
  function automatic int apb_slot_of(logic [31:0] a);
    return int'((a - APB_BASE) >> 12);
  endfunction
  // mapped-slot index of an address in the APB window, -1 when the slot is empty
  function automatic int apb_mapped_of(logic [31:0] a);
    int sl = apb_slot_of(a);
    foreach (APB_MAPPED_SLOT[i]) if (APB_MAPPED_SLOT[i] == sl) return i;
    return -1;
  endfunction

{% endif %}  // ---------------- mesh placement and latency ----------------
  localparam int M_X [NM] = '{ {{ m.masters|map(attribute='node')|map('first')|join(', ') }} };
  localparam int M_Y [NM] = '{ {{ m.masters|map(attribute='node')|map('last')|join(', ') }} };
  localparam int S_X [NS] = '{ {{ m.targets|map(attribute='node')|map('first')|join(', ') }} };
  localparam int S_Y [NS] = '{ {{ m.targets|map(attribute='node')|map('last')|join(', ') }} };
  // XY hops, master m to slave port s
  localparam int HOPS [NM][NS] = '{
{% for x in m.masters %}    '{ {{ x.hops|join(', ') }} }{{ ',' if not loop.last }}   // {{ x.name }}
{% endfor %}  };
  // request path (one way + IOMMU TLB hit), response path, ideal single-beat
  // zero-load read latency (request + access + response), in clock cycles
  localparam int REQ_LAT [NM][NS] = '{
{% for x in m.masters %}    '{ {{ x.req|join(', ') }} }{{ ',' if not loop.last }}
{% endfor %}  };
  localparam int RSP_LAT [NM][NS] = '{
{% for x in m.masters %}    '{ {{ x.rsp|join(', ') }} }{{ ',' if not loop.last }}
{% endfor %}  };
  localparam int IDEAL_LAT [NM][NS] = '{
{% for x in m.masters %}    '{ {{ x.ideal|join(', ') }} }{{ ',' if not loop.last }}
{% endfor %}  };
  // one way NoC latency: 2*NI + (hops+1)*ROUTER + hops*LINK
  function automatic int noc_lat(int mi, int si);
    return 2 * NI_CYCLES + (HOPS[mi][si] + 1) * ROUTER_CYCLES + HOPS[mi][si] * LINK_CYCLES;
  endfunction
  function automatic int {{ m.prefix }}_noc_lat(int mi, int si); return noc_lat(mi, si); endfunction

  // ---------------- IOMMUs ----------------
  localparam int NIOMMU = {{ m.iommus|length }};
{% for io in m.iommus %}  localparam int IOMMU_{{ io.name|upper }} = {{ io.index }};   // {{ io.masters|join(', ') }}, TLB {{ io.tlb_entries }} entries
{% endfor %}  localparam int M_IOMMU [NM] = '{ {{ iommu_of|join(', ') }} };   // -1: none
  localparam int IOMMU_TLB_HIT [NIOMMU > 0 ? NIOMMU : 1] = '{ {{ (m.iommus|map(attribute='tlb_hit')|join(', ')) or '0' }} };
  function automatic int iommu_of(int mi); return M_IOMMU[mi]; endfunction

  // ---------------- master kind ----------------
  localparam bit M_IS_RTL [NM] = '{ {{ m.masters|map(attribute='kind')|map('is_rtl')|join(', ') }} };

  // ---------------- QoS ----------------
  localparam int M_PRIORITY [NM] = '{ {{ m.masters|map(attribute='priority')|join(', ') }} };
  localparam string M_QOS [NM] = '{ {{ m.masters|map(attribute='qos_class')|map('sv_str')|join(', ') }} };
  localparam int M_LAT_TARGET [NM] = '{ {{ m.masters|map(attribute='latency_target')|join(', ') }} };   // 0: none
  localparam int M_BW_MBPS [NM] = '{ {{ m.masters|map(attribute='traffic')|map(attribute='bandwidth')|join(', ') }} };

  // one address per (master, slave port) inside that master's private slice
  localparam logic [31:0] PATH_ADDR [NM][NS] = '{
{% for x in m.masters %}    '{ {{ x.path_addr|map('sv_h32')|join(', ') }} }{{ ',' if not loop.last }}
{% endfor %}  };
  localparam bit HAS_UNMAPPED = {{ 1 if unmapped is not none else 0 }};
  localparam logic [31:0] UNMAPPED_ADDR = 32'h{{ '%08X'|format(unmapped or 0) }};
endpackage
`endif
