// ============================================================================
// {{ m.name }}_ral_pkg -- UVM register model of the APB slots, generated by
// socgen from {{ spec_rel }}. Open-ip blocks come from docs/ip/<IP>.md of
// open-ip-portfolio @ {{ ip_commit[:12] }}; the others from register_blocks.
//   {{ m.name }}_reg_block   top block, map "map" at 0 (AXI byte addresses)
//   <slot>_blk          one sub-block per mapped APB slot
//   {{ m.name }}_axi_reg_adapter  RAL <-> axi4_item, single 32-bit beats
// Registers whose value the hardware changes (core-backed, pop, W1C) are
// marked NO_REG_TESTS; the reset test checks the rest.
// ============================================================================
`ifndef {{ M }}_RAL_PKG_SV
`define {{ M }}_RAL_PKG_SV
package {{ m.name }}_ral_pkg;
  import uvm_pkg::*;
  `include "uvm_macros.svh"
  import axi4_pkg::*;
  import {{ m.name }}_pkg::*;

{% for blk in ral_blocks %}  // ======================= {{ blk.type }} ({{ blk.src }}) =======================
{% for r in blk.regs %}  class {{ blk.type }}_{{ r.name|lower }} extends uvm_reg;
    `uvm_object_utils({{ blk.type }}_{{ r.name|lower }})
{% for f in r.fields %}    rand uvm_reg_field {{ f.name }};
{% endfor %}    function new(string name = "{{ r.name|lower }}");
      super.new(name, 32, UVM_NO_COVERAGE);
    endfunction
    virtual function void build();
{% for f in r.fields %}      {{ f.name }} = uvm_reg_field::type_id::create("{{ f.name }}");
      {{ f.name }}.configure(this, {{ f.width }}, {{ f.lsb }}, "{{ f.access }}", {{ 1 if f.volatile else 0 }}, {{ f.width }}'h{{ '%X'|format(f.reset) }}, 1, {{ 1 if f.access == 'RW' else 0 }}, 0);
{% endfor %}    endfunction
  endclass

{% endfor %}  class {{ blk.type }} extends uvm_reg_block;
    `uvm_object_utils({{ blk.type }})
{% for r in blk.regs %}    rand {{ blk.type }}_{{ r.name|lower }} {{ r.name }};
{% endfor %}    function new(string name = "{{ blk.type }}");
      super.new(name, UVM_NO_COVERAGE);
    endfunction
    virtual function void build();
      default_map = create_map("map", 0, 4, UVM_LITTLE_ENDIAN, 1);
{% for r in blk.regs %}      {{ r.name }} = {{ blk.type }}_{{ r.name|lower }}::type_id::create("{{ r.name }}");
      {{ r.name }}.configure(this);
      {{ r.name }}.build();
      default_map.add_reg({{ r.name }}, 'h{{ '%03X'|format(r.offset) }}, "{{ 'RW' if r.access in ('RW','W1C') else r.access }}");
{% if not r.testable %}      uvm_resource_db#(bit)::set({"REG::", {{ r.name }}.get_full_name()}, "NO_REG_TESTS", 1, this);
{% endif %}{% endfor %}      lock_model();
    endfunction
  endclass

{% endfor %}  // ======================= top block =======================
  class {{ m.name }}_reg_block extends uvm_reg_block;
    `uvm_object_utils({{ m.name }}_reg_block)
{% for s in m.apb.slots if s.ral_type %}    rand {{ s.ral_type }} {{ s.name }};
{% endfor %}    uvm_reg_map map;
    function new(string name = "{{ m.name }}_reg_block");
      super.new(name, UVM_NO_COVERAGE);
    endfunction
    virtual function void build();
      map = create_map("map", 0, 4, UVM_LITTLE_ENDIAN, 1);
      default_map = map;
{% for s in m.apb.slots if s.ral_type %}      {{ s.name }} = {{ s.ral_type }}::type_id::create("{{ s.name }}");
      {{ s.name }}.configure(this);
      {{ s.name }}.build();
      map.add_submap({{ s.name }}.default_map, 'h{{ '%08X'|format(s.base) }});
{% endfor %}      lock_model();
    endfunction
  endclass

  // RAL <-> AXI4: each register access is one INCR burst of one 32-bit beat
  class {{ m.name }}_axi_reg_adapter extends uvm_reg_adapter;
    `uvm_object_utils({{ m.name }}_axi_reg_adapter)
    function new(string name = "{{ m.name }}_axi_reg_adapter");
      super.new(name);
      supports_byte_enable = 1;
      provides_responses   = 0;      // the AXI driver writes the response into the request
    endfunction
    virtual function uvm_sequence_item reg2bus(const ref uvm_reg_bus_op rw);
      axi4_item t = axi4_item::type_id::create("ral_axi");
      t.write = (rw.kind == UVM_WRITE);
      t.id = 0; t.addr = 32'(rw.addr); t.len = 0; t.size = 3'd2; t.burst = AXI4_INCR;
      t.alloc();
      t.data[0] = 32'(rw.data);
      t.strb[0] = t.write ? 4'(rw.byte_en) : 4'hF;
      if (t.write && t.strb[0] == 4'h0) t.strb[0] = 4'hF;
      return t;
    endfunction
    virtual function void bus2reg(uvm_sequence_item bus_item, ref uvm_reg_bus_op rw);
      axi4_item t;
      if (!$cast(t, bus_item)) `uvm_fatal("RAL_ADAPT", "not an axi4_item")
      rw.kind   = t.write ? UVM_WRITE : UVM_READ;
      rw.addr   = t.addr;
      rw.data   = t.data.size() ? t.data[0] : 0;
      rw.status = (t.resp.size() && t.resp[0] == AXI4_OKAY) ? UVM_IS_OK : UVM_NOT_OK;
    endfunction
  endclass
endpackage
`endif
