// ============================================================================
// {{ m.name }}_tb_top -- generated by socgen from {{ spec_rel }}
//   m_if[NM]  master ports: VIP masters drive them{% if rtl_masters %}, RTL masters ({{ rtl_masters|map(attribute='name')|join(', ') }}) too{% endif %}

//   s_if[NS]  NoC slave ports: memory VIPs, {% if m.apb %}the APB subsystem (S_{{ m.apb.name|upper }}){% endif %}{% if rtl_slaves %}, RTL slaves{% endif %}

{% if m.noc.model == 'behavioral' %}//   the NoC between them is the env's behavioural {{ m.name }}_noc component
{% elif m.noc.model == 'mesh' %}//   the NoC between them is the generated {{ m.name }}_noc RTL (router mesh + network interfaces)
{% else %}//   the NoC between them is {{ m.noc.rtl_module }} (ports: aclk, aresetn, m_if[NM], s_if[NS])
{% endif %}// ============================================================================
`timescale 1ns/1ps
module {{ m.name }}_tb_top;
  import uvm_pkg::*;
  `include "uvm_macros.svh"
  import {{ m.name }}_pkg::*;
  import {{ m.name }}_test_pkg::*;

  logic {{ m.clock.name }} = 1'b0;
  logic aresetn = 1'b0;
  always #({{ m.clock.period_ns / 2 }}) {{ m.clock.name }} = ~{{ m.clock.name }};
  initial begin
    repeat (10) @(posedge {{ m.clock.name }});
    aresetn <= 1'b1;
  end

{% set if_rst = 'vip_resetn' if m.chiplet.dies > 1 else 'aresetn' %}{% if m.chiplet.dies > 1 %}  // chiplet: the VIPs start once the UCIe die-to-die link is up (the NoC and the
  // APB subsystem come out of reset with aresetn; link training takes some clocks)
  logic d2d_up, d2d_error, vip_resetn = 1'b0;
  logic [31:0] d2d_flits, d2d_replays;
  always @(posedge {{ m.clock.name }}) if (aresetn && d2d_up) vip_resetn <= 1'b1;
  always @(posedge {{ m.clock.name }}) if (aresetn && d2d_error) $error("die-to-die link error (gateway overflow or UCIe LINKERROR)");
  final $display("D2D link: %0d flits corrupted by the PHY model, %0d UCIe replays", d2d_flits, d2d_replays);
{% endif %}  axi4_if m_if [NM] (.aclk({{ m.clock.name }}), .aresetn({{ if_rst }}));
  axi4_if s_if [NS] (.aclk({{ m.clock.name }}), .aresetn({{ if_rst }}));
{% for s in vip_slots %}  apb_if  apb_{{ s.name }}_if (.pclk({{ m.clock.name }}), .presetn(aresetn));
{% endfor %}
  for (genvar i = 0; i < NM; i++) begin : g_m
    axi4_sva #(.NAME($sformatf("m_%0d", i))) u_sva (m_if[i]);
    initial begin
      uvm_config_db#(virtual axi4_if)::set(null, $sformatf("uvm_test_top.env.m_%s.*", M_NAME[i]), "vif", m_if[i]);
      uvm_config_db#(virtual axi4_if)::set(null, "uvm_test_top.env.noc", $sformatf("m_vif_%0d", i), m_if[i]);
    end
  end
  for (genvar i = 0; i < NS; i++) begin : g_s
    axi4_sva #(.NAME($sformatf("s_%0d", i))) u_sva (s_if[i]);
    initial begin
      uvm_config_db#(virtual axi4_if)::set(null, $sformatf("uvm_test_top.env.s_%s.*", S_NAME[i]), "vif", s_if[i]);
      uvm_config_db#(virtual axi4_if)::set(null, "uvm_test_top.env.noc", $sformatf("s_vif_%0d", i), s_if[i]);
    end
  end
{% if m.noc.model == 'rtl' %}
  {{ m.noc.rtl_module }} u_noc (.aclk({{ m.clock.name }}), .aresetn(aresetn), .m_if(m_if), .s_if(s_if));
{% elif m.noc.model == 'mesh' %}
{{ noc_hookup }}{% endif %}{% if m.apb %}
  // ---------------- APB subsystem on S_{{ m.apb.name|upper }} ----------------
{% for s in ext_slots if s.kind == 'rtl_master' %}  logic [31:0] {{ s.name }}_paddr, {{ s.name }}_pwdata, {{ s.name }}_prdata;
  logic        {{ s.name }}_psel, {{ s.name }}_penable, {{ s.name }}_pwrite, {{ s.name }}_pready, {{ s.name }}_pslverr;
  logic [3:0]  {{ s.name }}_pstrb;
{% endfor %}
  logic [{{ (m.apb.slots|length) - 1 }}:0] apb_irq;
  {{ m.name }}_apb_subsys u_apb (
    .clk({{ m.clock.name }}), .rst_n(aresetn),
{% for sig in ['awid','awaddr','awlen','awsize','awburst','awprot','awvalid','awready','wdata','wstrb','wlast','wvalid','wready','bid','bresp','bvalid','bready','arid','araddr','arlen','arsize','arburst','arprot','arvalid','arready','rid','rdata','rresp','rlast','rvalid','rready'] %}    .{{ sig }}(s_if[S_{{ m.apb.name|upper }}].{{ sig }}),
{% endfor %}{% for s in vip_slots %}    .{{ s.name }}_paddr(apb_{{ s.name }}_if.paddr), .{{ s.name }}_psel(apb_{{ s.name }}_if.psel), .{{ s.name }}_penable(apb_{{ s.name }}_if.penable),
    .{{ s.name }}_pwrite(apb_{{ s.name }}_if.pwrite), .{{ s.name }}_pwdata(apb_{{ s.name }}_if.pwdata), .{{ s.name }}_pstrb(apb_{{ s.name }}_if.pstrb),
    .{{ s.name }}_pprot(apb_{{ s.name }}_if.pprot), .{{ s.name }}_prdata(apb_{{ s.name }}_if.prdata), .{{ s.name }}_pready(apb_{{ s.name }}_if.pready),
    .{{ s.name }}_pslverr(apb_{{ s.name }}_if.pslverr),
{% endfor %}{% for s in ext_slots if s.kind == 'rtl_master' %}    .{{ s.name }}_paddr({{ s.name }}_paddr), .{{ s.name }}_psel({{ s.name }}_psel), .{{ s.name }}_penable({{ s.name }}_penable),
    .{{ s.name }}_pwrite({{ s.name }}_pwrite), .{{ s.name }}_pwdata({{ s.name }}_pwdata), .{{ s.name }}_pstrb({{ s.name }}_pstrb),
    .{{ s.name }}_pprot(), .{{ s.name }}_prdata({{ s.name }}_prdata), .{{ s.name }}_pready({{ s.name }}_pready),
    .{{ s.name }}_pslverr({{ s.name }}_pslverr),
{% endfor %}    .irq(apb_irq)
  );
{% for s in vip_slots %}  apb_sva #(.NAME("apb_{{ s.name }}")) u_apb_{{ s.name }}_sva (apb_{{ s.name }}_if);
  initial uvm_config_db#(virtual apb_if)::set(null, "uvm_test_top.env.apb_{{ s.name }}.*", "vif", apb_{{ s.name }}_if);
{% endfor %}{% endif %}{% for x in rtl_masters %}
  // ---------------- RTL master {{ x.name }}: {{ x.rtl.module }} ----------------
  {{ x.rtl.module }} {% if x.rtl.params %}#({% for k, v in x.rtl.params.items() %}.{{ k }}({{ v }}){{ ', ' if not loop.last }}{% endfor %}) {% endif %}u_{{ x.name }} (
    .{{ x.rtl.clock }}({{ m.clock.name }}), .{{ x.rtl.reset }}(aresetn){% for sig in rtl_axi_sigs %},
    .{{ x.rtl.prefix }}{{ sig }}(m_if[M_{{ x.name|upper }}].{{ sig }}{% if sig in ('awid', 'bid', 'arid', 'rid') %}[ID_WIDTH-1:0]{% endif %}){% endfor %}{% if x.rtl.apb %},
    .psel({{ x.rtl.apb }}_psel), .penable({{ x.rtl.apb }}_penable), .pwrite({{ x.rtl.apb }}_pwrite),
    .paddr({{ x.rtl.apb }}_paddr[11:0]), .pwdata({{ x.rtl.apb }}_pwdata), .pstrb({{ x.rtl.apb }}_pstrb),
    .pready({{ x.rtl.apb }}_pready), .prdata({{ x.rtl.apb }}_prdata), .pslverr({{ x.rtl.apb }}_pslverr){% endif %}

  );
  assign m_if[M_{{ x.name|upper }}].awid[7:ID_WIDTH] = '0;
  assign m_if[M_{{ x.name|upper }}].arid[7:ID_WIDTH] = '0;
  assign m_if[M_{{ x.name|upper }}].awlock = 1'b0;
  assign m_if[M_{{ x.name|upper }}].arlock = 1'b0;
  assign m_if[M_{{ x.name|upper }}].awcache = 4'h0;
  assign m_if[M_{{ x.name|upper }}].arcache = 4'h0;
  assign m_if[M_{{ x.name|upper }}].awprot = 3'h0;
  assign m_if[M_{{ x.name|upper }}].arprot = 3'h0;
{% endfor %}{% for x in rtl_slaves %}
  // ---------------- RTL slave {{ x.name }} ----------------
  {{ x.rtl.module }} {% if x.rtl.params %}#({% for k, v in x.rtl.params.items() %}.{{ k }}({{ v }}){{ ', ' if not loop.last }}{% endfor %}) {% endif %}u_{{ x.name }} (
    .{{ x.rtl.clock }}({{ m.clock.name }}), .{{ x.rtl.reset }}(aresetn){% for sig in axi_sigs %},
    .{{ x.rtl.prefix }}{{ sig }}(s_if[S_{{ x.name|upper }}].{{ sig }}){% endfor %}

  );
{% endfor %}
  initial begin
    if ($test$plusargs("VCD")) begin
      $dumpfile("{{ m.name }}.vcd");
      $dumpvars(0, {{ m.name }}_tb_top);
    end
    run_test();
  end
endmodule
