// ============================================================================
// {{ m.name }}_apb_subsys -- APB subsystem behind NoC port S_{{ m.apb.name|upper }},
// generated by socgen from {{ spec_rel }}
//   AXI4 slave -> axi2apb_bridge -> slot decoder PADDR[{{ 11 + apb_slot_bits }}:12] ({{ apb_nslots }} slots of 4 KB)
{% for s in m.apb.slots %}//   slot {{ '%2d'|format(s.slot) }}  0x{{ '%08X'|format(s.base) }}  {{ '%-16s'|format(s.name) }} {% if s.kind == 'ip' %}open-ip {{ s.ip }}_apb{% if s.axi_slave %} (+ AXI port S_{{ s.axi_slave.name|upper }}){% endif %}{% elif s.kind == 'regs' %}{{ m.name }}_{{ s.regs }}_regs{% elif s.kind == 'rtl_master' %}register port of RTL master {{ s.rtl_master }}{% else %}external APB port (VIP){% endif %}

{% endfor %}//   empty slots answer PSLVERR
// ============================================================================
module {{ m.name }}_apb_subsys (
  input  logic        clk,
  input  logic        rst_n,
  // AXI4 slave (from the NoC)
  input  logic [7:0]  awid,   input  logic [31:0] awaddr, input  logic [7:0] awlen,
  input  logic [2:0]  awsize, input  logic [1:0]  awburst, input logic [2:0] awprot,
  input  logic        awvalid, output logic       awready,
  input  logic [31:0] wdata,  input  logic [3:0]  wstrb,  input  logic wlast,
  input  logic        wvalid, output logic        wready,
  output logic [7:0]  bid,    output logic [1:0]  bresp,  output logic bvalid, input logic bready,
  input  logic [7:0]  arid,   input  logic [31:0] araddr, input  logic [7:0] arlen,
  input  logic [2:0]  arsize, input  logic [1:0]  arburst, input logic [2:0] arprot,
  input  logic        arvalid, output logic       arready,
  output logic [7:0]  rid,    output logic [31:0] rdata,  output logic [1:0] rresp,
  output logic        rlast,  output logic        rvalid, input  logic rready,
{% for s in ext_slots %}  // external APB completer port: {{ s.name }} (slot {{ s.slot }}{% if s.kind == 'rtl_master' %}, RTL master {{ s.rtl_master }}{% endif %})
  output logic [31:0] {{ s.name }}_paddr,  output logic {{ s.name }}_psel, output logic {{ s.name }}_penable,
  output logic        {{ s.name }}_pwrite, output logic [31:0] {{ s.name }}_pwdata, output logic [3:0] {{ s.name }}_pstrb,
  output logic [2:0]  {{ s.name }}_pprot,
  input  logic [31:0] {{ s.name }}_prdata, input logic {{ s.name }}_pready, input logic {{ s.name }}_pslverr,
{% endfor %}{% for s in axi_slots %}  // AXI4 subordinate port of {{ s.name }} ({{ s.ip }}_apb {{ s.axi_slave.prefix }}*): NoC port S_{{ s.axi_slave.name|upper }}
{% for x in s.axi_ports %}  {{ x.dir }} logic [{{ x.width - 1 }}:0] {{ x.port }},
{% endfor %}{% endfor %}  output logic [{{ (m.apb.slots|length) - 1 }}:0] irq        // one per mapped slot, slot order (0 when the block has none)
);
  logic [31:0] paddr, pwdata, prdata;
  logic        psel, penable, pwrite, pready, pslverr;
  logic [3:0]  pstrb;
  logic [2:0]  pprot;

  axi2apb_bridge #(.IDW(8)) u_bridge (
    .clk, .rst_n,
    .awid, .awaddr, .awlen, .awsize, .awburst, .awprot, .awvalid, .awready,
    .wdata, .wstrb, .wlast, .wvalid, .wready, .bid, .bresp, .bvalid, .bready,
    .arid, .araddr, .arlen, .arsize, .arburst, .arprot, .arvalid, .arready,
    .rid, .rdata, .rresp, .rlast, .rvalid, .rready,
    .paddr, .psel, .penable, .pwrite, .pwdata, .pstrb, .pprot, .prdata, .pready, .pslverr
  );

  // ---------------- slot decode ----------------
  localparam int NMAP = {{ m.apb.slots|length }};
  wire [{{ apb_slot_bits - 1 }}:0] slot = paddr[{{ 11 + apb_slot_bits }}:12];
  logic        s_psel    [NMAP];
  logic [31:0] s_prdata  [NMAP];
  logic        s_pready  [NMAP];
  logic        s_pslverr [NMAP];
  localparam logic [{{ apb_slot_bits - 1 }}:0] SLOT [NMAP] = '{ {{ m.apb.slots|map(attribute='slot')|join(', ') }} };
  always_comb begin
    prdata  = 32'h0;
    pready  = 1'b1;
    pslverr = psel & penable;                    // empty slot
    for (int i = 0; i < NMAP; i++) begin
      s_psel[i] = psel && (slot == SLOT[i]);
      if (slot == SLOT[i]) begin
        prdata  = s_prdata[i];
        pready  = s_pready[i];
        pslverr = s_pslverr[i];
      end
    end
  end

{% for s in m.apb.slots %}{% set i = loop.index0 %}  // ---------------- slot {{ s.slot }}: {{ s.name }} ----------------
{% if s.kind == 'ip' %}{% for p in s.wrapper.pins %}{% if p.dir == 'inout' %}  tri1 [{{ p.width - 1 }}:0] {{ s.name }}_{{ p.name }};      // weak pull-up{% if not (s.dev and p.name in s.pins_vip.inout|map(attribute='pin')|list) %}, nothing else drives it{% else %}; the device model drives it too{% endif %}
{% elif p.dir == 'output' %}  logic [{{ p.width - 1 }}:0] {{ s.name }}_{{ p.name }};
{% endif %}{% endfor %}{% if s.dev %}{% for d in s.dev.decl %}  {{ d }}
{% endfor %}{% endif %}  {{ s.ip }}_apb {% if s.params %}#({% for k, v in s.params.items() %}.{{ k }}({{ v }}){{ ', ' if not loop.last }}{% endfor %}) {% endif %}u_{{ s.name }} (
    .PCLK(clk), .PRESETN(rst_n), .PSEL(s_psel[{{ i }}]), .PENABLE(penable), .PWRITE(pwrite),
    .PADDR(paddr[11:0]), .PWDATA(pwdata), .PSTRB(pstrb),
    .PRDATA(s_prdata[{{ i }}]), .PREADY(s_pready[{{ i }}]), .PSLVERR(s_pslverr[{{ i }}]){% if s.wrapper.has_irq %}, .irq(irq[{{ i }}]){% endif %}{% for p in s.wrapper.pins %},
    .{{ p.name }}({% if p.dir == 'input' %}{{ s.pin_expr.get(p.name, "'0") }}{% else %}{{ s.name }}_{{ p.name }}{% endif %}){% endfor %}

  );
{% for x in s.axi_ports if x.dir == 'output' %}  assign {{ x.port }} = {{ s.name }}_{{ x.pin }};
{% endfor %}{% if s.dev %}  // pin-level device model on {{ s.name }}'s pins (pins_vip)
  {{ s.dev.model }} {% if s.dev.params %}#({% for k, v in s.dev.params.items() %}.{{ k }}({{ v }}){{ ', ' if not loop.last }}{% endfor %}) {% endif %}u_{{ s.name }}_dev (
{% for k, v in s.dev.conns %}    .{{ k }}({{ v }}){{ ',' if not loop.last }}
{% endfor %}  );
{% for a in s.dev.assigns %}  {{ a }}
{% endfor %}{% endif %}{% if not s.wrapper.has_irq %}  assign irq[{{ i }}] = 1'b0;
{% endif %}{% elif s.kind == 'regs' %}{% set b = m.register_blocks[s.regs] %}  {{ m.name }}_{{ s.regs }}_regs u_{{ s.name }} (
    .PCLK(clk), .PRESETN(rst_n), .PSEL(s_psel[{{ i }}]), .PENABLE(penable), .PWRITE(pwrite),
    .PADDR(paddr[11:0]), .PWDATA(pwdata), .PSTRB(pstrb),
    .PRDATA(s_prdata[{{ i }}]), .PREADY(s_pready[{{ i }}]), .PSLVERR(s_pslverr[{{ i }}]){% for r in b.regs if r.access in ('RO','W1C') and r.name != 'ID' %},
    .hw_{{ r.name|lower }}(32'h0){% endfor %}{% for r in b.regs if r.access in ('RW','WO') %},
    .q_{{ r.name|lower }}(){% endfor %}{% for r in b.regs if r.access == 'WO' %},
    .we_{{ r.name|lower }}(){% endfor %}

  );
  assign irq[{{ i }}] = 1'b0;
{% else %}  assign {{ s.name }}_paddr   = paddr;
  assign {{ s.name }}_psel    = s_psel[{{ i }}];
  assign {{ s.name }}_penable = penable & s_psel[{{ i }}];
  assign {{ s.name }}_pwrite  = pwrite;
  assign {{ s.name }}_pwdata  = pwdata;
  assign {{ s.name }}_pstrb   = pstrb;
  assign {{ s.name }}_pprot   = pprot;
  assign s_prdata[{{ i }}]  = {{ s.name }}_prdata;
  assign s_pready[{{ i }}]  = {{ s.name }}_pready;
  assign s_pslverr[{{ i }}] = {{ s.name }}_pslverr;
  assign irq[{{ i }}] = 1'b0;
{% endif %}
{% endfor %}endmodule
