// ============================================================================
// {{ m.name }}_{{ bn }}_regs -- APB4 register file generated by socgen from
// register_blocks.{{ bn }} in {{ spec_rel }}. {{ b.desc }}
//  - zero wait states, 32-bit data, 12-bit byte address, PSTRB byte lanes
//  - PSLVERR on an unmapped or misaligned offset
//  - hw_* inputs: values of RO registers and set pulses of W1C bits (from the
//    block's logic; tie to 0 for a register-only model)
// ============================================================================
module {{ m.name }}_{{ bn }}_regs (
  input  logic        PCLK,
  input  logic        PRESETN,
  input  logic        PSEL,
  input  logic        PENABLE,
  input  logic        PWRITE,
  input  logic [11:0] PADDR,
  input  logic [31:0] PWDATA,
  input  logic [3:0]  PSTRB,
  output logic [31:0] PRDATA,
  output logic        PREADY,
  output logic        PSLVERR{% for r in b.regs if r.access in ('RO','W1C') and r.name != 'ID' %},
  input  logic [31:0] hw_{{ r.name|lower }}{% endfor %}{% for r in b.regs if r.access in ('RW','WO') %},
  output logic [31:0] q_{{ r.name|lower }}{% endfor %}{% for r in b.regs if r.access == 'WO' %},
  output logic        we_{{ r.name|lower }}{% endfor %}
);
  wire        acc   = PSEL & PENABLE;
  wire        wr    = acc & PWRITE;
  wire [31:0] wmask = {{ '{{' }}8{PSTRB[3]}}, {8{PSTRB[2]}}, {8{PSTRB[1]}}, {8{PSTRB[0]}}};
  logic       hit;
  always_comb begin
    hit = 1'b0;
    case (PADDR)
{% for r in b.regs %}      12'h{{ '%03X'|format(r.offset) }}: hit = 1'b1;
{% endfor %}      default: hit = 1'b0;
    endcase
  end
  assign PREADY  = acc;
  assign PSLVERR = acc & ~hit;

{% for r in b.regs %}{% set mask = r.fields|sum(attribute='mask') %}  // {{ '%03X'|format(r.offset) }} {{ r.name }} {{ r.access }} reset 0x{{ '%08X'|format(r.reset) }}{% if r.desc %}: {{ r.desc }}{% endif %}
{% if r.access == 'RW' %}  logic [31:0] r_{{ r.name|lower }};
  always_ff @(posedge PCLK or negedge PRESETN)
    if (!PRESETN) r_{{ r.name|lower }} <= 32'h{{ '%08X'|format(r.reset) }};
    else if (wr && PADDR == 12'h{{ '%03X'|format(r.offset) }})
      r_{{ r.name|lower }} <= ((r_{{ r.name|lower }} & ~wmask) | (PWDATA & wmask)) & 32'h{{ '%08X'|format(mask) }};
  assign q_{{ r.name|lower }} = r_{{ r.name|lower }};
{% elif r.access == 'WO' %}  logic [31:0] r_{{ r.name|lower }};
  always_ff @(posedge PCLK or negedge PRESETN)
    if (!PRESETN) r_{{ r.name|lower }} <= 32'h{{ '%08X'|format(r.reset) }};
    else if (wr && PADDR == 12'h{{ '%03X'|format(r.offset) }})
      r_{{ r.name|lower }} <= ((r_{{ r.name|lower }} & ~wmask) | (PWDATA & wmask)) & 32'h{{ '%08X'|format(mask) }};
  assign q_{{ r.name|lower }} = r_{{ r.name|lower }};
  assign we_{{ r.name|lower }} = wr && PADDR == 12'h{{ '%03X'|format(r.offset) }};
{% elif r.access == 'W1C' %}  logic [31:0] r_{{ r.name|lower }};
  always_ff @(posedge PCLK or negedge PRESETN)
    if (!PRESETN) r_{{ r.name|lower }} <= 32'h{{ '%08X'|format(r.reset) }};
    else r_{{ r.name|lower }} <= ((r_{{ r.name|lower }} & ~((wr && PADDR == 12'h{{ '%03X'|format(r.offset) }}) ? (PWDATA & wmask) : 32'h0))
                         | hw_{{ r.name|lower }}) & 32'h{{ '%08X'|format(mask) }};
{% endif %}{% endfor %}
  always_comb begin
    PRDATA = 32'h0;
    if (acc && !PWRITE)
      case (PADDR)
{% for r in b.regs %}{% set mask = r.fields|sum(attribute='mask') %}        12'h{{ '%03X'|format(r.offset) }}: PRDATA = {% if r.name == 'ID' %}32'h{{ '%08X'|format(r.reset) }}{% elif r.access == 'RO' %}hw_{{ r.name|lower }} & 32'h{{ '%08X'|format(mask) }}{% elif r.access == 'WO' %}32'h0{% else %}r_{{ r.name|lower }}{% endif %};
{% endfor %}        default: PRDATA = 32'h0;
      endcase
  end
endmodule
