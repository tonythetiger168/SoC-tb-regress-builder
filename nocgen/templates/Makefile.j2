# Generated by nocgen for {{ cfg.name }}.
#   make vcs     TEST=noc_traffic_test
#   make xrun    TEST=noc_zero_load_test
#   make questa  TEST=noc_traffic_test
TEST ?= noc_zero_load_test
SEED ?= 1
ARGS ?=

vcs:
	vcs -full64 -sverilog -ntb_opts uvm-1.2 -timescale=1ns/1ps -f files.f -top tb_top -o simv -l comp.log
	./simv +UVM_TESTNAME=$(TEST) +ntb_random_seed=$(SEED) $(ARGS) -l sim.log

xrun:
	xrun -64bit -sv -uvm -uvmhome CDNS-1.2 -timescale 1ns/1ps -f files.f -top tb_top \
	     +UVM_TESTNAME=$(TEST) -svseed $(SEED) $(ARGS) -l sim.log

questa:
	vlib work && vlog -sv -timescale 1ns/1ps -f files.f && \
	vsim -c tb_top +UVM_TESTNAME=$(TEST) -sv_seed $(SEED) $(ARGS) -do "run -all; quit" -l sim.log

clean:
	rm -rf simv* csrc *.log *.key ucli.key xcelium.d xrun.history work transcript

.PHONY: vcs xrun questa clean
