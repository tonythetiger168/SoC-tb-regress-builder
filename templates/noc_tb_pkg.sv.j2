// Generated by nocgen for {{ cfg.name }}. Do not edit; rerun nocgen instead.
//
// UVM testbench for an AXI NoC mesh with {{ nm }} masters and {{ ns }} slaves.
// The TB drives every NoC master port, answers on every NoC slave port with a
// memory model, and checks each transaction for:
//   * routing: the response comes back OKAY from a mapped address, DECERR otherwise
//   * data:    reads return the last value written (per-master address partitions)
//   * latency: measured >= shortest-path minimum (anything faster means the
//              latency model or the DUT is wrong); under zero load, measured is
//              within zero_load_slack of the minimum; under traffic, within
//              latency_tolerance x minimum.
package noc_tb_pkg;
  import uvm_pkg::*;
  `include "uvm_macros.svh"
  import noc_params_pkg::*;

  localparam bit [1:0] RESP_OKAY = 2'b00, RESP_SLVERR = 2'b10, RESP_DECERR = 2'b11;
  localparam int       BPB       = AXI_DW / 8;   // bytes per beat
  localparam bit       HAS_HOLE  = {{ 1 if prof.hole is not none else 0 }};
  localparam addr_t    HOLE_ADDR = {{ aw }}'h{{ '%x' % (prof.hole or 0) }};  // an unmapped address

  function automatic string master_name(int i);
    case (i)
{% for m in masters %}
      {{ m.idx }}: return "{{ m.name }}";
{% endfor %}
      default: return $sformatf("master%0d", i);
    endcase
  endfunction

  function automatic string slave_name(int i);
    case (i)
{% for s in slaves %}
      {{ s.idx }}: return "{{ s.name }}";
{% endfor %}
      default: return "UNMAPPED";
    endcase
  endfunction

  // ==========================================================================
  // Config
  // ==========================================================================
  class noc_cfg extends uvm_object;
    int    num_txns          = {{ cfg.num_txns }};
    real   latency_tolerance = {{ cfg.latency_tolerance }};
    int    zero_load_slack   = {{ cfg.zero_load_slack }};
    bit    zero_load         = 0;   // set by noc_zero_load_test
    bit    slow_is_error     = 0;   // +NOC_SLOW_IS_ERROR turns LAT_SLOW into an error
    `uvm_object_utils(noc_cfg)
    function new(string name = "noc_cfg");
      super.new(name);
      void'($value$plusargs("NOC_TXNS=%d", num_txns));
      void'($value$plusargs("NOC_TOL=%f", latency_tolerance));
      void'($value$plusargs("NOC_SLACK=%d", zero_load_slack));
      if ($test$plusargs("NOC_SLOW_IS_ERROR")) slow_is_error = 1;
    endfunction
  endclass

  // ==========================================================================
  // Transaction
  // ==========================================================================
  class axi_item extends uvm_sequence_item;
    rand bit       is_write;
    rand addr_t    addr;
    rand bit [7:0] len;
    rand id_t      id;
    rand data_t    wdata[];
    // Set by the sequence before randomize(): the address window to pick from.
    addr_t         lo, hi;
    // Filled in by the monitor.
    int            master = -1;
    int            slave  = -1;
    bit [1:0]      resp;
    data_t         rdata[$];
    strb_t         wstrb[$];
    longint        t_start, t_first, t_end;   // cycle numbers

    constraint c_len   { len inside {[0:15]}; }
    constraint c_addr  { addr inside {[lo:hi]};
                         addr % BPB == 0;
                         // AXI4 A3.4.1: a burst must not cross a 4 KB boundary.
                         int'(addr % 4096) + (int'(len) + 1) * BPB <= 4096; }
    constraint c_wdata { wdata.size() == (is_write ? int'(len) + 1 : 0); }
    constraint c_order { solve is_write before wdata; solve len before wdata; }

    `uvm_object_utils_begin(axi_item)
      `uvm_field_int(is_write, UVM_ALL_ON)
      `uvm_field_int(addr,     UVM_ALL_ON | UVM_HEX)
      `uvm_field_int(len,      UVM_ALL_ON)
      `uvm_field_int(id,       UVM_ALL_ON)
      `uvm_field_int(resp,     UVM_ALL_ON)
      `uvm_field_int(master,   UVM_ALL_ON)
      `uvm_field_int(slave,    UVM_ALL_ON)
    `uvm_object_utils_end

    function new(string name = "axi_item");
      super.new(name);
    endfunction

    function int beats();
      return int'(len) + 1;
    endfunction

    function longint latency();
      return t_first - t_start;
    endfunction

    function string convert2string();
      return $sformatf("%s %s->%s addr=%h len=%0d id=%0d resp=%0d lat=%0d",
                       is_write ? "WR" : "RD", master_name(master), slave_name(slave),
                       addr, len, id, resp, latency());
    endfunction
  endclass

  // ==========================================================================
  // Master agent (TB is the AXI master on a NoC master port)
  // ==========================================================================
  typedef uvm_sequencer #(axi_item) axi_master_sequencer;

  class axi_master_driver extends uvm_driver #(axi_item);
    `uvm_component_utils(axi_master_driver)
    virtual axi_if vif;
    function new(string name, uvm_component parent);
      super.new(name, parent);
    endfunction

    function void build_phase(uvm_phase phase);
      if (!uvm_config_db#(virtual axi_if)::get(this, "", "vif", vif))
        `uvm_fatal("NOVIF", "master driver has no vif")
    endfunction

    task run_phase(uvm_phase phase);
      axi_item t;
      idle();
      @(posedge vif.rst_n);
      forever begin
        seq_item_port.get_next_item(t);
        if (t.is_write) do_write(t); else do_read(t);
        seq_item_port.item_done();
      end
    endtask

    task idle();
      vif.awvalid <= 0; vif.wvalid <= 0; vif.bready <= 0;
      vif.arvalid <= 0; vif.rready <= 0;
      vif.awid <= '0; vif.awaddr <= '0; vif.awlen <= '0; vif.awsize <= '0; vif.awburst <= '0;
      vif.wdata <= '0; vif.wstrb <= '0; vif.wlast <= 0;
      vif.arid <= '0; vif.araddr <= '0; vif.arlen <= '0; vif.arsize <= '0; vif.arburst <= '0;
    endtask

    task do_read(axi_item t);
      vif.arid <= t.id; vif.araddr <= t.addr; vif.arlen <= t.len;
      vif.arsize <= AXI_SIZE; vif.arburst <= 2'b01; vif.arvalid <= 1;
      do @(posedge vif.clk); while (!vif.arready);
      vif.arvalid <= 0;
      vif.rready <= 1;
      for (int i = 0; i <= t.len; i++) begin
        do @(posedge vif.clk); while (!vif.rvalid);
        t.rdata.push_back(vif.rdata);
        t.resp = vif.rresp;
        if (vif.rlast) break;
      end
      vif.rready <= 0;
    endtask

    task do_write(axi_item t);
      fork
        begin
          vif.awid <= t.id; vif.awaddr <= t.addr; vif.awlen <= t.len;
          vif.awsize <= AXI_SIZE; vif.awburst <= 2'b01; vif.awvalid <= 1;
          do @(posedge vif.clk); while (!vif.awready);
          vif.awvalid <= 0;
        end
        begin
          for (int i = 0; i <= t.len; i++) begin
            vif.wdata <= t.wdata[i]; vif.wstrb <= '1; vif.wlast <= (i == t.len); vif.wvalid <= 1;
            do @(posedge vif.clk); while (!vif.wready);
          end
          vif.wvalid <= 0; vif.wlast <= 0;
        end
      join
      vif.bready <= 1;
      do @(posedge vif.clk); while (!vif.bvalid);
      t.resp = vif.bresp;
      vif.bready <= 0;
    endtask
  endclass

  class axi_master_monitor extends uvm_monitor;
    `uvm_component_utils(axi_master_monitor)
    virtual axi_if vif;
    int idx;
    uvm_analysis_port #(axi_item) ap;
    longint cyc;
    axi_item rd_q[id_t][$];
    axi_item wr_q[id_t][$];
    data_t   w_data[$];
    strb_t   w_strb[$];

    function new(string name, uvm_component parent);
      super.new(name, parent);
      ap = new("ap", this);
    endfunction

    function void build_phase(uvm_phase phase);
      if (!uvm_config_db#(virtual axi_if)::get(this, "", "vif", vif))
        `uvm_fatal("NOVIF", "master monitor has no vif")
    endfunction

    task run_phase(uvm_phase phase);
      @(posedge vif.rst_n);
      forever begin
        @(posedge vif.clk);
        cyc++;
        if (vif.arvalid && vif.arready) begin
          axi_item t = axi_item::type_id::create("rd");
          t.is_write = 0; t.addr = vif.araddr; t.len = vif.arlen; t.id = vif.arid;
          t.master = idx; t.slave = decode(t.addr); t.t_start = cyc; t.t_first = -1;
          rd_q[t.id].push_back(t);
        end
        if (vif.rvalid && vif.rready) begin
          if (!rd_q.exists(vif.rid) || rd_q[vif.rid].size() == 0)
            `uvm_error("AXI_RID", $sformatf("%s: R beat with id %0d and no read outstanding", master_name(idx), vif.rid))
          else begin
            axi_item t = rd_q[vif.rid][0];
            if (t.t_first < 0) t.t_first = cyc;
            t.rdata.push_back(vif.rdata);
            t.resp = vif.rresp;
            if (vif.rlast) begin
              void'(rd_q[vif.rid].pop_front());
              t.t_end = cyc;
              if (t.rdata.size() != t.beats())
                `uvm_error("AXI_RLAST", $sformatf("%s: got %0d beats, expected %0d", t.convert2string(), t.rdata.size(), t.beats()))
              ap.write(t);
            end
          end
        end
        if (vif.awvalid && vif.awready) begin
          axi_item t = axi_item::type_id::create("wr");
          t.is_write = 1; t.addr = vif.awaddr; t.len = vif.awlen; t.id = vif.awid;
          t.master = idx; t.slave = decode(t.addr); t.t_start = cyc;
          wr_q[t.id].push_back(t);
        end
        if (vif.wvalid && vif.wready) begin
          w_data.push_back(vif.wdata);
          w_strb.push_back(vif.wstrb);
        end
        if (vif.bvalid && vif.bready) begin
          if (!wr_q.exists(vif.bid) || wr_q[vif.bid].size() == 0)
            `uvm_error("AXI_BID", $sformatf("%s: B with id %0d and no write outstanding", master_name(idx), vif.bid))
          else begin
            axi_item t = wr_q[vif.bid].pop_front();
            t.t_first = cyc; t.t_end = cyc; t.resp = vif.bresp;
            t.wdata = new[t.beats()];
            foreach (t.wdata[i]) begin
              if (w_data.size() == 0) begin
                `uvm_error("AXI_W", $sformatf("%s: B before all W beats", t.convert2string()))
                break;
              end
              t.wdata[i] = w_data.pop_front();
              t.wstrb.push_back(w_strb.pop_front());
            end
            ap.write(t);
          end
        end
      end
    endtask
  endclass

  class axi_master_agent extends uvm_agent;
    `uvm_component_utils(axi_master_agent)
    int idx;
    axi_master_sequencer sqr;
    axi_master_driver    drv;
    axi_master_monitor   mon;
    function new(string name, uvm_component parent);
      super.new(name, parent);
    endfunction
    function void build_phase(uvm_phase phase);
      sqr = axi_master_sequencer::type_id::create("sqr", this);
      drv = axi_master_driver::type_id::create("drv", this);
      mon = axi_master_monitor::type_id::create("mon", this);
      mon.idx = idx;
    endfunction
    function void connect_phase(uvm_phase phase);
      drv.seq_item_port.connect(sqr.seq_item_export);
    endfunction
  endclass

  // ==========================================================================
  // Slave responder (TB is the AXI slave on a NoC slave port): memory model
  // that answers after SLV_ACCESS_CYCLES[idx] cycles.
  // ==========================================================================
  class axi_slave_responder extends uvm_component;
    `uvm_component_utils(axi_slave_responder)
    virtual axi_if vif;
    int    idx;
    data_t mem[addr_t];
    int unsigned n_rd, n_wr, n_misrouted;

    function new(string name, uvm_component parent);
      super.new(name, parent);
    endfunction

    function void build_phase(uvm_phase phase);
      if (!uvm_config_db#(virtual axi_if)::get(this, "", "vif", vif))
        `uvm_fatal("NOVIF", "slave responder has no vif")
    endfunction

    function data_t rd_word(addr_t a);
      return mem.exists(a) ? mem[a] : init_word(a);
    endfunction

    function void check_route(addr_t a);
      if (decode(a) != idx) begin
        n_misrouted++;
        `uvm_error("NOC_ROUTE", $sformatf("%s received address %h that belongs to %s",
                   slave_name(idx), a, slave_name(decode(a))))
      end
    endfunction

    task run_phase(uvm_phase phase);
      vif.awready <= 0; vif.wready <= 0; vif.bvalid <= 0; vif.bid <= '0; vif.bresp <= '0;
      vif.arready <= 0; vif.rvalid <= 0; vif.rid <= '0; vif.rdata <= '0; vif.rresp <= '0; vif.rlast <= 0;
      @(posedge vif.rst_n);
      fork
        read_loop();
        write_loop();
      join
    endtask

    task read_loop();
      forever begin
        addr_t a; id_t id; int len;
        vif.arready <= 1;
        do @(posedge vif.clk); while (!vif.arvalid);
        a = vif.araddr; id = vif.arid; len = vif.arlen;
        vif.arready <= 0;
        check_route(a);
        n_rd++;
        repeat (SLV_ACCESS_CYCLES[idx] - 1) @(posedge vif.clk);
        for (int i = 0; i <= len; i++) begin
          vif.rvalid <= 1; vif.rid <= id; vif.rresp <= RESP_OKAY;
          vif.rdata <= rd_word(a + i * BPB); vif.rlast <= (i == len);
          do @(posedge vif.clk); while (!vif.rready);
        end
        vif.rvalid <= 0; vif.rlast <= 0;
      end
    endtask

    task write_loop();
      forever begin
        addr_t a; id_t id; int len;
        vif.awready <= 1;
        do @(posedge vif.clk); while (!vif.awvalid);
        a = vif.awaddr; id = vif.awid; len = vif.awlen;
        vif.awready <= 0;
        check_route(a);
        n_wr++;
        vif.wready <= 1;
        for (int i = 0; i <= len; i++) begin
          data_t old, mask;
          do @(posedge vif.clk); while (!vif.wvalid);
          old = rd_word(a + i * BPB);
          for (int b = 0; b < BPB; b++) mask[b*8 +: 8] = {8{vif.wstrb[b]}};
          mem[a + i * BPB] = (old & ~mask) | (vif.wdata & mask);
        end
        vif.wready <= 0;
        repeat (SLV_ACCESS_CYCLES[idx] - 1) @(posedge vif.clk);
        vif.bvalid <= 1; vif.bid <= id; vif.bresp <= RESP_OKAY;
        do @(posedge vif.clk); while (!vif.bready);
        vif.bvalid <= 0;
      end
    endtask
  endclass

  // ==========================================================================
  // Scoreboard: routing, data and latency
  // ==========================================================================
  class noc_scoreboard extends uvm_component;
    `uvm_component_utils(noc_scoreboard)
    uvm_analysis_imp #(axi_item, noc_scoreboard) imp;
    noc_cfg cfg;
    data_t  ref_mem[addr_t];

    // Per [master][slave][is_write] statistics.
    int unsigned n      [NUM_MASTERS][NUM_SLAVES][2];
    longint      lat_sum[NUM_MASTERS][NUM_SLAVES][2];
    longint      lat_min[NUM_MASTERS][NUM_SLAVES][2];
    longint      lat_max[NUM_MASTERS][NUM_SLAVES][2];
    longint      lat_ideal[NUM_MASTERS][NUM_SLAVES][2];  // model minimum, single beat
    int unsigned n_decerr, n_data_err, n_lat_fast, n_lat_slow, n_total;

    function new(string name, uvm_component parent);
      super.new(name, parent);
      imp = new("imp", this);
    endfunction

    function void build_phase(uvm_phase phase);
      if (!uvm_config_db#(noc_cfg)::get(this, "", "cfg", cfg))
        `uvm_fatal("NOCFG", "scoreboard has no noc_cfg")
      foreach (n[m, s, w]) begin
        lat_min[m][s][w] = 64'h7fff_ffff_ffff_ffff;
        lat_ideal[m][s][w] = min_latency(m, s, w, 1);
      end
    endfunction

    function data_t ref_word(addr_t a);
      return ref_mem.exists(a) ? ref_mem[a] : init_word(a);
    endfunction

    function void write(axi_item t);
      int s = t.slave;
      int w = t.is_write;
      longint lat, lo;
      n_total++;
      if (s < 0) begin
        n_decerr++;
        if (t.resp != RESP_DECERR)
          `uvm_error("NOC_DECERR", $sformatf("unmapped address must return DECERR: %s", t.convert2string()))
        return;
      end
      if (t.resp != RESP_OKAY)
        `uvm_error("NOC_RESP", $sformatf("expected OKAY: %s", t.convert2string()))

      // ---- latency ----
      lat = t.latency();
      lo  = min_latency(t.master, s, t.is_write, t.beats());
      if (lat < lo) begin
        n_lat_fast++;
        `uvm_error("LAT_TOO_FAST", $sformatf("%s is below the shortest-path minimum %0d; the latency model or the DUT is wrong",
                   t.convert2string(), lo))
      end else if (cfg.zero_load && lat - lo > cfg.zero_load_slack) begin
        n_lat_slow++;
        `uvm_error("LAT_ZERO_LOAD", $sformatf("%s is %0d cycles over the minimum %0d with no other traffic (slack %0d)",
                   t.convert2string(), lat - lo, lo, cfg.zero_load_slack))
      end else if (!cfg.zero_load && real'(lat) > cfg.latency_tolerance * real'(lo) + cfg.zero_load_slack) begin
        n_lat_slow++;
        if (cfg.slow_is_error)
          `uvm_error("LAT_SLOW", $sformatf("%s exceeds %0.2fx the minimum %0d", t.convert2string(), cfg.latency_tolerance, lo))
        else
          `uvm_warning("LAT_SLOW", $sformatf("%s exceeds %0.2fx the minimum %0d", t.convert2string(), cfg.latency_tolerance, lo))
      end
      n[t.master][s][w]++;
      lat_sum[t.master][s][w] += lat - (lo - lat_ideal[t.master][s][w]);  // normalise bursts to 1 beat
      if (lat - (lo - lat_ideal[t.master][s][w]) < lat_min[t.master][s][w]) lat_min[t.master][s][w] = lat - (lo - lat_ideal[t.master][s][w]);
      if (lat - (lo - lat_ideal[t.master][s][w]) > lat_max[t.master][s][w]) lat_max[t.master][s][w] = lat - (lo - lat_ideal[t.master][s][w]);

      // ---- data ----
      if (t.is_write) begin
        foreach (t.wdata[i]) begin
          data_t mask;
          addr_t a = t.addr + i * BPB;
          for (int b = 0; b < BPB; b++) mask[b*8 +: 8] = {8{t.wstrb[i][b]}};
          ref_mem[a] = (ref_word(a) & ~mask) | (t.wdata[i] & mask);
        end
      end else begin
        foreach (t.rdata[i]) begin
          addr_t a = t.addr + i * BPB;
          if (t.rdata[i] !== ref_word(a)) begin
            n_data_err++;
            `uvm_error("NOC_DATA", $sformatf("%s beat %0d @%h: got %h expected %h",
                       t.convert2string(), i, a, t.rdata[i], ref_word(a)))
          end
        end
      end
    endfunction

    function void report_phase(uvm_phase phase);
      string s;
      s = "\n  Latency per master/slave (cycles, normalised to 1 beat)\n";
      s = {s, $sformatf("  %-12s %-12s %-3s %6s %6s %6s %8s %6s %7s\n",
                        "master", "slave", "dir", "count", "ideal", "min", "avg", "max", "avg-ideal")};
      foreach (n[m, sl, w]) begin
        real avg;
        if (n[m][sl][w] == 0) continue;
        avg = real'(lat_sum[m][sl][w]) / n[m][sl][w];
        s = {s, $sformatf("  %-12s %-12s %-3s %6d %6d %6d %8.1f %6d %7.1f\n",
                          master_name(m), slave_name(sl), w ? "WR" : "RD", n[m][sl][w],
                          lat_ideal[m][sl][w], lat_min[m][sl][w], avg, lat_max[m][sl][w],
                          avg - lat_ideal[m][sl][w])};
      end
      s = {s, $sformatf("  transactions=%0d decode_err=%0d data_err=%0d too_fast=%0d too_slow=%0d\n",
                        n_total, n_decerr, n_data_err, n_lat_fast, n_lat_slow)};
      `uvm_info("NOC_SB", s, UVM_NONE)
      if (n_total == 0) `uvm_error("NOC_SB", "no transactions were checked")
    endfunction
  endclass

  // ==========================================================================
  // Env
  // ==========================================================================
  class noc_env extends uvm_env;
    `uvm_component_utils(noc_env)
    noc_cfg             cfg;
    axi_master_agent    m_agt[NUM_MASTERS];
    axi_slave_responder s_rsp[NUM_SLAVES];
    noc_scoreboard      sb;
    function new(string name, uvm_component parent);
      super.new(name, parent);
    endfunction
    function void build_phase(uvm_phase phase);
      if (!uvm_config_db#(noc_cfg)::get(this, "", "cfg", cfg))
        `uvm_fatal("NOCFG", "env has no noc_cfg")
      uvm_config_db#(noc_cfg)::set(this, "sb", "cfg", cfg);
      foreach (m_agt[i]) begin
        m_agt[i] = axi_master_agent::type_id::create($sformatf("m_agt%0d", i), this);
        m_agt[i].idx = i;
      end
      foreach (s_rsp[i]) begin
        s_rsp[i] = axi_slave_responder::type_id::create($sformatf("s_rsp%0d", i), this);
        s_rsp[i].idx = i;
      end
      sb = noc_scoreboard::type_id::create("sb", this);
    endfunction
    function void connect_phase(uvm_phase phase);
      foreach (m_agt[i]) m_agt[i].mon.ap.connect(sb.imp);
    endfunction
  endclass

  // ==========================================================================
  // Sequences
  // ==========================================================================
  class noc_base_seq extends uvm_sequence #(axi_item);
    `uvm_object_utils(noc_base_seq)
    int m;   // which master port this runs on
    function new(string name = "noc_base_seq");
      super.new(name);
    endfunction

    // Each master gets its own 4 KB-aligned slice of every slave so that
    // concurrent traffic keeps read-after-write data checks deterministic.
    function void window(int s, output addr_t lo, output addr_t hi);
      addr_t part = (SLV_SIZE[s] / NUM_MASTERS) & ~addr_t'(4095);
      if (part == 0) begin
        lo = SLV_BASE[s]; hi = SLV_BASE[s] + SLV_SIZE[s] - 1;
      end else begin
        lo = SLV_BASE[s] + part * m; hi = lo + part - 1;
      end
    endfunction

    task send(int s, bit is_write, int len = -1);
      axi_item t = axi_item::type_id::create("t");
      start_item(t);
      if (s < 0) begin
        t.lo = HOLE_ADDR; t.hi = HOLE_ADDR;
      end else
        window(s, t.lo, t.hi);
      if (!t.randomize() with { is_write == local::is_write; local::len < 0 || len == local::len; })
        `uvm_fatal("RAND", "axi_item randomize failed")
      finish_item(t);
    endtask
  endclass

  // Directed: one write and one read-back to every slave, single beat, then a
  // read to an unmapped address. Run one master at a time for zero-load latency.
  class noc_pair_seq extends noc_base_seq;
    `uvm_object_utils(noc_pair_seq)
    function new(string name = "noc_pair_seq");
      super.new(name);
    endfunction
    task body();
      for (int s = 0; s < NUM_SLAVES; s++) begin
        send(s, 1, 0);
        send(s, 0, 0);
      end
      if (HAS_HOLE) send(-1, 0, 0);
    endtask
  endclass

  // Random traffic, slaves picked by the config's traffic weights.
  class noc_traffic_seq extends noc_base_seq;
    `uvm_object_utils(noc_traffic_seq)
    int num_txns = 100;
    function new(string name = "noc_traffic_seq");
      super.new(name);
    endfunction
    function int pick_slave();
      int tot = 0, r;
      for (int s = 0; s < NUM_SLAVES; s++) tot += TRAFFIC_W[m][s];
      r = $urandom_range(tot - 1);
      for (int s = 0; s < NUM_SLAVES; s++) begin
        if (r < TRAFFIC_W[m][s]) return s;
        r -= TRAFFIC_W[m][s];
      end
      return NUM_SLAVES - 1;
    endfunction
    task body();
      repeat (num_txns) send(pick_slave(), $urandom_range(1));
    endtask
  endclass

  // ==========================================================================
  // Tests
  // ==========================================================================
  class noc_base_test extends uvm_test;
    `uvm_component_utils(noc_base_test)
    noc_env env;
    noc_cfg cfg;
    function new(string name, uvm_component parent);
      super.new(name, parent);
    endfunction
    function void build_phase(uvm_phase phase);
      cfg = noc_cfg::type_id::create("cfg");
      uvm_config_db#(noc_cfg)::set(this, "env", "cfg", cfg);
      env = noc_env::type_id::create("env", this);
    endfunction
    function void end_of_elaboration_phase(uvm_phase phase);
      uvm_top.print_topology();
    endfunction
  endclass

  // Each master in turn talks to every slave with nothing else in flight, so
  // measured latency must sit within zero_load_slack of the shortest path.
  class noc_zero_load_test extends noc_base_test;
    `uvm_component_utils(noc_zero_load_test)
    function new(string name, uvm_component parent);
      super.new(name, parent);
    endfunction
    function void build_phase(uvm_phase phase);
      super.build_phase(phase);
      cfg.zero_load = 1;
    endfunction
    task run_phase(uvm_phase phase);
      phase.raise_objection(this);
      for (int i = 0; i < NUM_MASTERS; i++) begin
        noc_pair_seq seq = noc_pair_seq::type_id::create($sformatf("pair%0d", i));
        seq.m = i;
        seq.start(env.m_agt[i].sqr);
      end
      phase.drop_objection(this);
    endtask
  endclass

  // All masters at once with weighted random traffic: contention, routing and
  // data integrity, with latency held to latency_tolerance x minimum.
  class noc_traffic_test extends noc_base_test;
    `uvm_component_utils(noc_traffic_test)
    function new(string name, uvm_component parent);
      super.new(name, parent);
    endfunction
    task run_phase(uvm_phase phase);
      phase.raise_objection(this);
      for (int i = 0; i < NUM_MASTERS; i++) begin
        automatic int k = i;
        fork begin
          noc_traffic_seq seq = noc_traffic_seq::type_id::create($sformatf("traffic%0d", k));
          seq.m = k;
          seq.num_txns = cfg.num_txns;
          seq.start(env.m_agt[k].sqr);
        end join_none
      end
      wait fork;
      phase.drop_objection(this);
    endtask
  endclass

endpackage
