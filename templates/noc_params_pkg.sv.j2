// {{ cfg.cols }}x{{ cfg.rows }} mesh, routing={{ cfg.routing }}, router={{ cfg.router_cycles }}cy link={{ cfg.link_cycles }}cy ni={{ cfg.ni_cycles }}cy
package noc_params_pkg;

  localparam int NUM_MASTERS = {{ nm }};
  localparam int NUM_SLAVES  = {{ ns }};
  localparam int AXI_AW      = {{ aw }};
  localparam int AXI_DW      = {{ dw }};
  localparam int AXI_IDW     = {{ idw }};
  localparam int AXI_SIZE    = $clog2(AXI_DW/8);   // full-width beats only

  typedef bit [AXI_AW-1:0]   addr_t;
  typedef bit [AXI_DW-1:0]   data_t;
  typedef bit [AXI_DW/8-1:0] strb_t;
  typedef bit [AXI_IDW-1:0]  id_t;

  // ---- Address map (from the memory profile) -------------------------------
{% for s in slaves %}
  localparam int {{ s.name|upper }} = {{ s.idx }};  // node ({{ placement[s.name][0] }},{{ placement[s.name][1] }})
{% endfor %}
  localparam addr_t SLV_BASE [NUM_SLAVES] = '{ {% for s in slaves %}{{ aw }}'h{{ '%x' % s.base }}{{ ", " if not loop.last }}{% endfor %} };
  localparam addr_t SLV_SIZE [NUM_SLAVES] = '{ {% for s in slaves %}{{ aw }}'h{{ '%x' % s.size }}{{ ", " if not loop.last }}{% endfor %} };
  localparam int    SLV_ACCESS_CYCLES [NUM_SLAVES] = '{ {% for s in slaves %}{{ s.latency }}{{ ", " if not loop.last }}{% endfor %} };

  // ---- Masters -------------------------------------------------------------
{% for m in masters %}
  localparam int {{ m.name|upper }} = {{ m.idx }};  // node ({{ placement[m.name][0] }},{{ placement[m.name][1] }})
{% endfor %}

  // ---- Shortest-path latency, cycles ---------------------------------------
  // REQ_LAT[m][s]: master NI -> slave NI.  RSP_LAT[m][s]: slave NI -> master NI.
  localparam int REQ_LAT [NUM_MASTERS][NUM_SLAVES] = '{
{% for row in req %}
    '{ {{ row|join(", ") }} }{{ "," if not loop.last }}  // {{ masters[loop.index0].name }}
{% endfor %}
  };
  localparam int RSP_LAT [NUM_MASTERS][NUM_SLAVES] = '{
{% for row in rsp %}
    '{ {{ row|join(", ") }} }{{ "," if not loop.last }}  // {{ masters[loop.index0].name }}
{% endfor %}
  };

  // Relative traffic weights (from the config's traffic matrix), used by the
  // random traffic sequence.
  localparam int TRAFFIC_W [NUM_MASTERS][NUM_SLAVES] = '{
{% for row in wi %}
    '{ {{ row|join(", ") }} }{{ "," if not loop.last }}  // {{ masters[loop.index0].name }}
{% endfor %}
  };

  // Returns the slave index for an address, or -1 for a decode error.
  function automatic int decode(addr_t a);
    for (int s = 0; s < NUM_SLAVES; s++)
      if (a >= SLV_BASE[s] && a - SLV_BASE[s] < SLV_SIZE[s]) return s;
    return -1;
  endfunction

  // Minimum cycles from AR handshake to first R beat (reads), or from AW
  // handshake to B (writes; W beats are serialised behind AW).
  function automatic int min_latency(int m, int s, bit is_write, int beats);
    return REQ_LAT[m][s] + SLV_ACCESS_CYCLES[s] + RSP_LAT[m][s] + (is_write ? beats - 1 : 0);
  endfunction

  // Value a slave returns for a word that was never written. The slave model
  // and the scoreboard both use it.
  function automatic data_t init_word(addr_t a);
    data_t d;
    for (int i = 0; i < AXI_DW; i += 32) d[i +: 32] = 32'hA5A5_0000 ^ a[31:0] ^ i;
    return d;
  endfunction

endpackage
